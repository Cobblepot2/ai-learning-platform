# Gemini API (server-side only, never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase (optional for local demo: without these, progress is stored in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: writes verified dynamic activity results after user-scoped access checks.
# Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=
