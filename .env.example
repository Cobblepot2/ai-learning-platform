# Gemini API (server-side only, never expose to the browser).
# Reserved for the AI evaluator; the current build grades with an offline evaluator.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase. Sign-in and saved project runs need all three.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: saves project runs after the signed-in user is checked.
# Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=
